{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/milinpatel07/Autonomous-Driving_AI-Safety-and-Security/benchmark/schema.json",
  "title": "SOTIF perception benchmark result (schema 1.0)",
  "type": "object",
  "required": ["schema_version", "benchmark", "submission", "run", "requirement", "metrics", "triggering_conditions", "release"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "required": ["name", "spec_version", "spec_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "spec_version": {"type": "string", "minLength": 1},
        "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "submission": {
      "type": "object",
      "required": ["name", "model", "weights", "training_data", "score_threshold", "date"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "weights": {"type": "string", "minLength": 1},
        "training_data": {"type": "string", "minLength": 1},
        "framework": {"type": "string"},
        "score_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "avsafety_version": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": ["n_frames", "conditions", "official"],
      "properties": {
        "runtime_s": {"type": "number", "minimum": 0},
        "n_frames": {"type": "integer", "minimum": 1},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "official": {"type": "boolean"},
        "hardware": {"type": "string"}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "cls", "min_recall", "confidence", "max_speed_kmh", "odd_conditions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cls": {"enum": ["pedestrian", "cyclist", "car"]},
        "min_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "max_speed_kmh": {"type": "number", "minimum": 0},
        "odd_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["by_condition", "by_distance", "by_occlusion", "by_truncation", "lens_dirt"],
      "properties": {
        "by_condition": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["condition", "class", "n", "detected", "recall", "ci_low", "ci_high", "fp", "fp_per_frame"],
            "properties": {
              "condition": {"type": "string"},
              "class": {"enum": ["pedestrian", "cyclist", "car"]},
              "n": {"type": "integer", "minimum": 0},
              "detected": {"type": "integer", "minimum": 0},
              "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "ci_low": {"type": "number", "minimum": 0, "maximum": 1},
              "ci_high": {"type": "number", "minimum": 0, "maximum": 1},
              "fp": {"type": "integer", "minimum": 0},
              "fp_per_frame": {"type": "number", "minimum": 0}
            }
          }
        },
        "by_distance": {"type": "array"},
        "by_occlusion": {"type": "array"},
        "by_truncation": {"type": "array"},
        "lens_dirt": {"type": "array"}
      }
    },
    "triggering_conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition", "in_odd", "n", "recall", "lower_bound", "verdict", "v_max_kmh"],
        "properties": {
          "condition": {"type": "string"},
          "in_odd": {"type": "boolean"},
          "n": {"type": "integer", "minimum": 0},
          "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "lower_bound": {"type": "number", "minimum": 0, "maximum": 1},
          "verdict": {"enum": ["meets", "does not meet", "inconclusive", "no data"]},
          "v_max_kmh": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "release": {
      "type": "object",
      "required": ["verdict", "requirement", "reasons"],
      "properties": {
        "verdict": {"enum": ["RELEASE", "RELEASE WITH ODD RESTRICTION", "DO NOT RELEASE"]},
        "requirement": {"type": "string"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
